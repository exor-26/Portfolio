# Firebase Admin service account as base64-encoded JSON.
# PowerShell example:
# [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content -Raw "C:\path\firebase-service-account.json")))
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Firestore project ID is optional when it is present in the service account JSON.
FIREBASE_PROJECT_ID=llm-depth
FIRESTORE_DATABASE_ID=default

# Keep these private. Do not expose them through VITE_* variables.
ADMIN_SECRET=
SESSION_COOKIE_SECRET=
IP_HASH_SALT=

COURSE_SESSION_MINUTES=45
DAILY_SESSION_LIMIT=2
DEVTOOLS_WARNING_LIMIT=2
EVENT_SUSPEND_THRESHOLD=18
EVENT_BAN_THRESHOLD=35
